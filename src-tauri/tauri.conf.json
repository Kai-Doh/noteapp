{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "noteapp",
  "version": "0.1.0",
  "identifier": "com.kaidoh.noteapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "noteapp",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4MTkxOEYyQTkyMzE0M0IKUldRN0ZDT3A4aGdaNkpTdkpSdmZpTGZRbXZNbERjeG9xNGpZcVQ1ZXFBNld5V0VIS29UMzYvZHYK",
      "endpoints": [
        "https://github.com/Kai-Doh/noteapp/releases/latest/download/latest.json"
      ]
    }
  }
}
